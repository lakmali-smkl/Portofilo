# Copy this file to ".env" (same folder) and fill in the values below.

# ---- Required — cloud database ----
# All content (profile, projects, skills, education, experience, events,
# certificates, messages) and every uploaded photo is stored in MongoDB
# Atlas, not on disk. Create a free cluster at
# https://www.mongodb.com/cloud/atlas/register and paste its connection
# string here (Database -> Connect -> Drivers -> Node.js).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/portfolio?appName=Cluster0

# ---- Optional — email notifications for the Contact form ----
# Without these, the site still works fully — every message is still
# saved in MongoDB and shows up in the "Messages" tab of Manage Projects.
# Email is purely an optional extra.
# The Gmail account that will SEND the notification email.
# Do NOT use your normal Gmail password here — Google blocks that.
# Instead, create an "App Password":
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces don't matter)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword

# ---- Optional ----
# Where the notification email should be delivered. Defaults to SMTP_USER.
SMTP_TO=youraddress@gmail.com

# Only needed if you're using a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
